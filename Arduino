#include <WiFi.h>
#include <WiFiUdp.h>
#include <ESP32Servo.h>

//  Configuración de WiFi
const char *ssid = "Roborregos";  
const char *password = "RoBorregos2025";  

//  Configuración UDP
WiFiUDP udp;
const unsigned int localPort = 1234;
char packetBuffer[255];

//  Configuración del servomotor
Servo gripperServo;  
#define SERVO_PIN 12  
#define POS_ABIERTO 0    // Ángulo de apertura máxima
#define POS_CERRADO 180  // Ángulo de cierre máximo

//  Configuración del potenciómetro
#define POT_PIN 34  

//  Configuración del sensor ACS712
#define ACS712_PIN 35  
const float ACS712_OFFSET = 2.5;      // Voltaje en reposo
const float ACS712_SENSITIVITY = 0.185; // Sensibilidad para 5A
#define UMBRAL_BLOQUEO 3.5  // 3.5 A para detectar bloqueo (ajustable)

//  Configuración de los sensores FSR (opcional)
#define FSR1_PIN 32  
#define FSR2_PIN 33  
#define UMBRAL_FSR 500  // Umbral de fuerza (opcional)

//  IP de la PC
const char *PC_IP = "192.168.1.217";  // IP de tu PC
const unsigned int PC_PORT = 1234;   

//  Modo de control
bool modoAuto = true;  
int servoAngle = POS_ABIERTO;  // Inicia abierto
bool closing = false;  // Bandera para cierre progresivo

void setup() {
  Serial.begin(115200);
  
  // Conectar a WiFi
  WiFi.begin(ssid, password);
  Serial.print("Conectando a WiFi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\n Conectado a WiFi");
  Serial.print("📡 IP del ESP32: ");
  Serial.println(WiFi.localIP());

  // Iniciar UDP
  udp.begin(localPort);
  Serial.println(" Servidor UDP iniciado.");

  // Configurar servomotor
  gripperServo.attach(SERVO_PIN);
  gripperServo.write(servoAngle);
  
  Serial.println(" Sensores y servomotor listos.");
  delay(2000);  // Pequeña pausa inicial
}

void loop() {
  //  Leer sensores
  int potValue = analogRead(POT_PIN);  
  int fsr1Value = analogRead(FSR1_PIN);  
  int fsr2Value = analogRead(FSR2_PIN);  
  int rawValue = analogRead(ACS712_PIN);
  float voltage = (rawValue * 3.3) / 4095.0;
  float current = (voltage - ACS712_OFFSET) / ACS712_SENSITIVITY;

  //  Calcular distancia del gripper
  float gripperDistance = (7.0 / 180.0) * servoAngle + 1.4;

  //  Enviar datos por UDP (aunque Python los ignore)
  char udpMessage[100];
  snprintf(udpMessage, sizeof(udpMessage), "%d,%.2f,%.3f,%d,%d", 
           servoAngle, gripperDistance, current, fsr1Value, fsr2Value);
  udp.beginPacket(PC_IP, PC_PORT);
  udp.print(udpMessage);
  udp.endPacket();

  //  Recibir comandos UDP
  int packetSize = udp.parsePacket();
  if (packetSize) {
    int len = udp.read(packetBuffer, 255);
    if (len > 0) packetBuffer[len] = 0;  
    String command = String(packetBuffer);

    if (command.equalsIgnoreCase("AUTO")) {
      modoAuto = true;
      closing = false;
      Serial.println(" Modo AUTO activado.");
    } else if (command.equalsIgnoreCase("MANUAL")) {
      modoAuto = false;
      closing = false;
      Serial.println(" Modo MANUAL activado.");
    } else if (command.equalsIgnoreCase("CLOSE")) {
      modoAuto = false;
      closing = true;
      servoAngle = POS_ABIERTO;  // Iniciar abierto
      gripperServo.write(servoAngle);
      Serial.println(" Iniciando cierre progresivo.");
    } else if (command.equalsIgnoreCase("OPEN")) {
      modoAuto = false;
      closing = false;
      servoAngle = POS_ABIERTO;  // Abrir completamente
      gripperServo.write(servoAngle);
      Serial.println(" Gripper abierto.");
    } else if (!modoAuto && !closing) {
      int receivedAngle = command.toInt();
      if (receivedAngle >= POS_ABIERTO && receivedAngle <= POS_CERRADO) {
        servoAngle = receivedAngle;
        Serial.print(" Ángulo recibido: ");
        Serial.println(servoAngle);
      } else {
        Serial.println(" Comando no válido.");
      }
    }
  }

  // 🎮 Control del servo
  if (modoAuto) {
    int targetAngle = map(potValue, 0, 4095, POS_ABIERTO, POS_CERRADO);
    if (current < UMBRAL_BLOQUEO) {
      servoAngle = targetAngle;
      gripperServo.write(servoAngle);
    } else {
      gripperServo.write(servoAngle);  // Mantener posición al bloquearse
      Serial.println(" Bloqueo detectado por corriente.");
    }
  } else if (closing) {
    if (current < UMBRAL_BLOQUEO && servoAngle < POS_CERRADO) {
      servoAngle += 1;  // Cierre lento (1° por iteración)
      gripperServo.write(servoAngle);
      delay(100);  // 100 ms por paso (ajustable)
    } else {
      closing = false;  // Detener cierre, mantener posición
      Serial.println(" Gripper bloqueado, objeto agarrado.");
    }
  } else {
    gripperServo.write(servoAngle);  // Modo manual o tras abrir
  }

  //  Depuración en monitor serial
  Serial.printf("Ángulo: %d° | Corriente: %.3f A | FSR1: %d | FSR2: %d\n", 
                servoAngle, current, fsr1Value, fsr2Value);
  delay(50);  // Pequeña pausa para estabilidad
}
